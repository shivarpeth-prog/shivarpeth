<!doctype html><html lang="mr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/static/style.css"><title>LIVE Posts</title></head><body><div class="wrap"><div class="nav"><div class="brand">🏘️ <%=appName%></div><a class="btn" href="/">Post करा</a></div><div class="card"><h1>LIVE Posts</h1><% if(!posts.length){%><p class="muted">अजून approved posts नाहीत.</p><%}%><% posts.forEach(p=>{%><article class="post"><h3><%=p.name%></h3><p><%=p.post_text%></p><p class="muted">📞 <%=p.mobile%> · <%=new Date(p.created_at).toLocaleString('en-IN')%></p></article><%})%></div></div></body></html>
