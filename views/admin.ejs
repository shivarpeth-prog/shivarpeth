<!doctype html><html lang="mr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/static/style.css"><title>Admin</title></head><body><div class="wrap"><div class="nav"><div class="brand">Admin — <%=appName%></div><form method="post" action="/admin/logout"><button>Logout</button></form></div><div class="card"><h1>Payment Verification</h1><% if(!payments.length){%><p class="muted">No submissions.</p><%}%><%payments.forEach(p=>{%><div class="post"><h3>#<%=p.id%> · <%=p.name%> · <%=p.status.toUpperCase()%></h3><p><b>Mobile:</b> <%=p.mobile%></p><p><b>UTR:</b> <span class="utr"><%=p.utr%></span></p><p><b>Post:</b> <%=p.post_text%></p><p><a class="btn" href="<%=p.screenshot%>" target="_blank" rel="noopener">Screenshot उघडा</a></p><%if(p.status==='pending'){%><div class="admin-actions"><form method="post" action="/admin/payment/<%=p.id%>/approve"><input name="admin_note" placeholder="Approval note (optional)"><button>✅ Approve & LIVE</button></form><form method="post" action="/admin/payment/<%=p.id%>/reject"><input name="admin_note" placeholder="Rejection reason"><button class="danger">❌ Reject</button></form></div><%}else{%><p class="muted">Reviewed: <%=p.reviewed_at%> <%if(p.admin_note){%>· Note: <%=p.admin_note%><%}%></p><%}%></div><%})%></div></div></body></html>
